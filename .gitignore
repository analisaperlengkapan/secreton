# Rust
/target/
# Cargo.lock IS committed. This is an application, not a library: the lockfile is what
# makes `--locked` builds, `cargo audit` and Dependabot describe the artifact that ships.

# Leptos / cargo-leptos build output
/target/site/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/

# Local config that may hold real values
/secreton.local.toml

# CI/CD artifacts
*.lcov
lcov.info
geiger-report.json
trivy-results.sarif

# Coverage reports
coverage/


# Temporary files
*.tmp
*.bak

# SSL certificates
/certs/
*.pem
!crates/**/testdata/*.pem

# Node tooling (screenshots). The manifest and lockfile are committed; the installed
# tree is not. Nothing here is needed for the Rust build.
/node_modules/
